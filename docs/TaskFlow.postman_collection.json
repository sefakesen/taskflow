{
  "info": {
    "_postman_id": "taskflow-collection-v1",
    "name": "TaskFlow API — Test Koleksiyonu",
    "description": "TaskFlow Görev Yönetim Sistemi REST API testleri",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string",
      "description": "POST /api/tasks yanıtından otomatik doldurulur"
    }
  ],
  "item": [
    {
      "name": "🏠 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"]
        }
      }
    },
    {
      "name": "📋 Zorunlu CRUD",
      "item": [
        {
          "name": "1. Tüm Görevleri Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "2. Yeni Görev Oluştur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.task) {",
                  "  pm.collectionVariables.set('task_id', res.task.id);",
                  "  console.log('task_id değişkeni ayarlandı:', res.task.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Görevi\",\n  \"description\": \"Bu görev Postman üzerinden oluşturuldu.\",\n  \"priority\": \"high\",\n  \"assignee\": \"test-kullanici\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "3. Görev Detayı (ID ile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "4. Görevi Güncelle (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"critical\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "4b. Görevi Kısmi Güncelle (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee\": \"zeynep\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "5. Görevi Sil",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "🔍 Filtreleme (İsteğe Bağlı 01)",
      "item": [
        {
          "name": "Duruma Göre Filtrele (completed)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?status=completed",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "completed" }]
            }
          }
        },
        {
          "name": "Önceliğe Göre Filtrele (high)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?priority=high",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "priority", "value": "high" }]
            }
          }
        },
        {
          "name": "Anahtar Kelime Ara",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks/search?keyword=backend",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "search"],
              "query": [{ "key": "keyword", "value": "backend" }]
            }
          }
        },
        {
          "name": "Kullanıcıya Göre Listele (musa)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks/assignee/musa",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "assignee", "musa"]
            }
          }
        },
        {
          "name": "Sayfalama (page=1 limit=2)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?page=1&limit=2",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Sıralama (createdAt desc)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?sort=createdAt&order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "sort", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "✅ Validation (İsteğe Bağlı 02)",
      "item": [
        {
          "name": "Hatalı İstek — title eksik",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Hatalı İstek — geçersiz priority",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test\",\n  \"priority\": \"urgent\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Raporlama (İsteğe Bağlı 03)",
      "item": [
        {
          "name": "Genel Özet",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "summary"]
            }
          }
        },
        {
          "name": "Tamamlanan Görevler",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/completed",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "completed"]
            }
          }
        },
        {
          "name": "Bekleyen Görevler",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/pending",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "pending"]
            }
          }
        },
        {
          "name": "Kritik Görevler",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/critical",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "critical"]
            }
          }
        }
      ]
    }
  ]
}
