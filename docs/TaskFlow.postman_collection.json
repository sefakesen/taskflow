{
  "info": {
    "_postman_id": "taskflow-collection-v1",
    "name": "TaskFlow API - Test Koleksiyonu",
    "description": "TaskFlow Gorev ve Proje Yonetim Sistemi REST API Testleri",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string",
      "description": "POST /api/tasks yanitindan otomatik doldurulur"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"]
        }
      }
    },
    {
      "name": "Zorunlu CRUD Islemleri",
      "item": [
        {
          "name": "1. Tum Gorevleri Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "2. Yeni Gorev Olustur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.task) {",
                  "  pm.collectionVariables.set('task_id', res.task.id);",
                  "  console.log('task_id degiskeni ayarlandi:', res.task.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Gorevi\",\n  \"description\": \"Bu gorev Postman uzerinden olusturuldu.\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "3. Gorev Detayi (ID ile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "4. Gorevi Guncelle (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"critical\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "5. Gorevi Sil (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Filtreleme ve Arama (Istege Bagli 01)",
      "item": [
        {
          "name": "Duruma Gore Filtrele (completed)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?status=completed",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "completed" }]
            }
          }
        },
        {
          "name": "Oncelige Gore Filtrele (high)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?priority=high",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "priority", "value": "high" }]
            }
          }
        },
        {
          "name": "Anahtar Kelime Arama (keyword)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks/search?keyword=backend",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "search"],
              "query": [{ "key": "keyword", "value": "backend" }]
            }
          }
        },
        {
          "name": "Kullaniciya Gore Listele (assignee)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks/assignee/musa",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "assignee", "musa"]
            }
          }
        },
        {
          "name": "Sayfalama (page ve limit)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?page=1&limit=2",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Siralama (sort ve order)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tasks?sort=createdAt&order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "sort", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dogrulama (Istege Bagli 02)",
      "item": [
        {
          "name": "Hatali Istek: title eksik",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Hatali Istek: gecersiz priority",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Gorevi\",\n  \"priority\": \"urgent\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            }
          }
        }
      ]
    },
    {
      "name": "Raporlama (Istege Bagli 03)",
      "item": [
        {
          "name": "Genel Sistem Ozeti",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "summary"]
            }
          }
        },
        {
          "name": "Tamamlanan Gorevler",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/completed",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "completed"]
            }
          }
        },
        {
          "name": "Bekleyen Gorevler",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/pending",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "pending"]
            }
          }
        }
      ]
    }
  ]
}
